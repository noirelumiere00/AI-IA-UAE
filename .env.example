# AI-IA-UAE 環境変数サンプル（.env にコピーして使用。実値はコミットしないこと）

# --- モデルプロバイダ ---
# heuristic = ネットワーク不要のルールベース（雛形検証/CIの既定）
# bedrock   = Amazon Bedrock 経由（本番・機密データはVPC/IAM内）
# api       = 第一者 Claude API（試作）
AIIA_PROFILE=heuristic

# --- AWS / Bedrock（AIIA_PROFILE=bedrock のとき） ---
AWS_REGION=us-east-1
# 推奨: IAMロール/短期STS。長期キーを使う場合のみ以下を設定（コミット禁止）
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- 第一者 Claude API（AIIA_PROFILE=api のとき） ---
# ANTHROPIC_API_KEY=

# --- 配信先（Slack DM のユーザーID） ---
SLACK_DELIVERY_USER_ID=U09CX1CCBLN

# --- 設定ディレクトリ / 対象ユーザー ---
AIIA_CONFIG_DIR=./config
AIIA_USER=example_user

# --- Slackユーザー認可（任意・未返信メンションリマインド用） ---
# SLACK_CLIENT_ID を入れた時だけ Slack連携が有効（段階導入）。メールだけなら不要。
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_OAUTH_REDIRECT_URI=        # 公開URL + /oauth2/slack/callback
# AIIA_SLACK_TOKEN_TABLE=aiia-slack-tokens
